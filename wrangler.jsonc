{
	"main": "dist/_worker.js",
	"name": "astro-http",
  "compatibility_date": "2025-12-18",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "vars": {
    "ASTRO_DB_REMOTE_URL": "libsql://05-database-cesvelasquez22.aws-us-east-2.turso.io"
  },
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
    "enabled": true
  }
}